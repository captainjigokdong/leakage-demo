       "file_path": "/tmp/claude-0/-srv-leakruns-278c665bce74-t2-ws/aa5a2397-2791-4d0b-b6aa-277765821b4f/scratchpad/card.py",
       "content": "# 결정 카드 근사 (표본 수, 결과율만). pandas가 깨져 있어 표준 라이브러리로 계산한다.\nimport gzip, csv, collections, datetime as dt\nD = '/srv/leakruns/278c665bce74-t2/ws/data/'\nrd = lambda f: list(csv.DictReader(gzip.open(D + f, 'rt')))\nT = dt.datetime.fromisoformat\nH = lambda x: x.timestamp() / 3600\nP = {p['patient_id']: p for p in rd('patients.csv.gz')}\nA = rd('admissions.csv.gz')\ncr = collections.defaultdict(list)\nfor l in rd('labs.csv.gz'):\n    if l['test'] == 'creatinine':\n        cr[l['admission_id']].append((H(T(l['collect_time'])), H(T(l['report_time'])), float(l['value'])))\n\n\ndef kdigo_hits(seq):\n    \"\"\"seq: 채취 순 (h, v). 기준을 만족한 측정의 위치들.\"\"\"\n    out = []\n    for j in range(1, len(seq)):\n        hj, vj = seq[j]\n        p = [v for h, v in seq[:j] if h >= hj - 168]\n        if p and vj >= 1.5 * min(p) - 1e-9:\n            out.append(j); continue\n        r = [v for h, v in seq[:j] if h >= hj - 48]\n        if r and vj - min(r) >= 0.3 - 1e-9:\n            out.append(j)\n    return out\n\n\ndef kdigo_first(seq):\n    h = kdigo_hits(seq)\n    return h[0] if h else None\n\n\nbase = excl = 0\npos = collections.Counter(); n = collections.Counter(); adms = set(); pts = set()\nfor a in A:\n    ad, dc = H(T(a['admit_time'])), H(T(a['discharge_time']))\n    if int(P[a['patient_id']]['age']) < 18:\n        continue\n    rows = sorted(cr[a['admission_id']])\n    for o in (24, 48, 72, 96, 120, 144, 168):\n        tp = ad + o\n        if not tp < dc:\n            continue\n        base += 1\n        known = sorted((c, v) for c, r, v in rows if ad < r <= tp)\n        if kdigo_first(known) is not None:\n            excl += 1; continue\n        seq = sorted((c, v) for c, r, v in rows if tp - 168 < c <= tp + 48)\n        y = any(tp < seq[j][0] <= tp + 48 for j in kdigo_hits(seq))\n        for k in ('all', a['unit']):\n            n[k] += 1; pos[k] += y\n        adms.add(a['admission_id']); pts.add(a['patient_id'])\nprint('예측 행(제외 전)', base, '제외', excl)\nprint('코호트 행', n['all'], '입원', len(adms), '환자', len(pts))\nfor k in n:\n    print(k, n[k], pos[k], round(pos[k] / n[k], 4))\n"
