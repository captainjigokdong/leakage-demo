       "content": "import gzip, csv, collections as C\nfrom datetime import datetime as D, timedelta as T\nDATA = '/srv/leakruns/8dab1848f9d0-t2/ws/data/'\nrd = lambda f: list(csv.DictReader(gzip.open(DATA + f + '.csv.gz', 'rt')))\nt = lambda s: D.strptime(s, '%Y-%m-%d %H:%M:%S')\nA = rd('admissions'); L = rd('labs')\ncr = C.defaultdict(list)\nfor l in L:\n    if l['test'] == 'creatinine':\n        cr[l['admission_id']].append((t(l['collect_time']), t(l['report_time']), float(l['value'])))\n\n\ndef kd(series, lo, hi, ct):\n    for s in series:\n        if not (lo <= s[ct] < hi):\n            continue\n        prev = [p for p in series if p[0] < s[0]]\n        if any(s[0] - p[0] <= T(hours=48) and s[2] - p[2] >= 0.3 for p in prev) or \\\n           any(s[0] - p[0] <= T(days=7) and s[2] >= 1.5 * p[2] for p in prev):\n            return True\n    return False\n\n\nst = C.Counter()\nfor a in A:\n    ad, dc = t(a['admit_time']), t(a['discharge_time']); s = sorted(cr[a['admission_id']])\n    for h in [24, 48, 72, 96, 120, 144, 168]:\n        tp = ad + T(hours=h)\n        if tp > dc:\n            st['tp_after_dc'] += 1; continue\n        if kd(s, ad, tp, 1):\n            st['excl'] += 1; continue\n        st['rows'] += 1\n        y = kd(s, tp, tp + T(hours=48), 0)\n        cens = dc < tp + T(hours=48)\n        st[('cens', cens, a['discharge_status'])] += 1\n        st[('y', a['unit'], y)] += 1\n        st[('y_cens', cens, y)] += 1\n        pend = any(c < tp <= r for c, r, v in s)\n        st[('pending_cr_at_tp', pend, y)] += 1\n        st[('ncr48', a['unit'])] += sum(tp <= c < tp + T(hours=48) for c, r, v in s)\nfor k, v in sorted(st.items(), key=str):\n    print(k, v)\n"
