       "command": "cd /srv/leakruns/8dab1848f9d0-t2/ws/data; python3 -c \"\nimport gzip,csv,collections as C\nfrom datetime import datetime as D,timedelta as T\nrd=lambda f:list(csv.DictReader(gzip.open(f+'.csv.gz','rt')))\nt=lambda s:D.strptime(s,'%Y-%m-%d %H:%M:%S')\nA=rd('admissions');L=rd('labs')\ncr=C.defaultdict(list)\nfor l in L:\n  if l['test']=='creatinine': cr[l['admission_id']].append((t(l['collect_time']),t(l['report_time']),float(l['value'])))\ndef kd(series,lo,hi,ct):\n  # any sample in [lo,hi) by time idx ct meets KDIGO vs prior samples\n  for i,s in enumerate(series):\n    if not(lo<=s[ct]<hi): continue\n    prev=[p for p in series if p[0]<s[0]]\n    if any(s[0]-p[0]<=T(hours=48) and s[2]-p[2]>=0.3 for p in prev) or any(s[0]-p[0]<=T(days=7) and s[2]>=1.5*p[2] for p in prev): return True\n  return False\nst=C.Counter()\nfor a in A:\n  ad,dc=t(a['admit_time']),t(a['discharge_time']);s=sorted(cr[a['admission_id']])\n  for h in [24,48,72,96,120,144,168]:\n    tp=ad+T(hours=h)\n    if tp>dc: st['tp_after_dc']+=1; continue\n    if kd(s,ad,tp,1): st['excl']+=1; continue\n    st['rows']+=1\n    y=kd(s,tp,tp+T(hours=48),0)\n    cens=dc<tp+T(hours=48)\n    st[('cens',cens,a['discharge_status'])]+=1\n    st[('y',a['unit'],y)]+=1\n    if any(c<tp<=r for c,r,v in s): st['pending_cr_at_tp']+=1\n    if any(c<tp<=r for c,r,v in s) and y: st['pending_and_y']+=1\n    st[('ncr48',a['unit'])]+=sum(tp<=c<tp+T(hours=48) for c,r,v in s)\nfor k,v in sorted(st.items(),key=str): print(k,v)\n\""
